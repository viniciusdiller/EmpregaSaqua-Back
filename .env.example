# Environment Variables

# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://USUARIO:SENHA@127.0.0.1:5432/NOME_DO_BANCO?schema=public"

PORT=3009

# Obrigatório, mínimo 32 caracteres (ex.: openssl rand -hex 48)
JWT_SECRET="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTUxNjIzOTAyMn0.KMUFsIDTnFmyG3nMiGM6H9FNFUROf3wh7SmqJp-QV30"

# --- Conta admin ---
# Login/senha do painel administrativo. Ao subir o back, essa conta é criada (ou sincronizada,
# se o e-mail já existir) automaticamente — mudar a senha aqui e reiniciar já atualiza o login.
# Sem essas duas variáveis, nenhuma conta admin é criada automaticamente. Senha: mínimo 8 caracteres.
ADMIN_EMAIL=admin@empregasaqua.com
ADMIN_PASSWORD=adminadmin

# URL do front, usada nos links dentro dos e-mails (ex.: alerta de vaga) e para a logo no
# cabeçalho dos e-mails ({{frontendUrl}}/logo.png precisa responder publicamente).
FRONTEND_URL=http://localhost:5173

# --- E-mail (SMTP) ---
# Usado para alertas de novas vagas e outras notificações por e-mail.
# Sem SMTP_HOST, os e-mails só são logados no console (não quebra nada em dev).
#
# Gmail: smtp.gmail.com, porta 587, SMTP_SECURE=false, senha = "App Password"
#   (não a senha normal da conta — gere em myaccount.google.com/apppasswords,
#   exige verificação em duas etapas ativada).
# Outlook/Hotmail: smtp.office365.com, porta 587, SMTP_SECURE=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EmpregaSaquá <no-reply@empregasaqua.com>"

# E-mail de contato mostrado para empresas com cadastro reprovado.
SUPPORT_EMAIL=
