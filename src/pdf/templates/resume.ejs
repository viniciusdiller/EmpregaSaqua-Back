<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Currículo - <%= profile.user?.email %></title>
  <style>
    body {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      color: #333;
      line-height: 1.6;
      margin: 0;
      padding: 0;
    }
    h1 {
      font-size: 24px;
      color: #2c3e50;
      border-bottom: 2px solid #3498db;
      padding-bottom: 5px;
      margin-bottom: 10px;
    }
    h2 {
      font-size: 18px;
      color: #2980b9;
      margin-top: 20px;
      margin-bottom: 10px;
    }
    .contact-info {
      font-size: 14px;
      color: #555;
      margin-bottom: 20px;
    }
    .section {
      margin-bottom: 25px;
    }
    .item {
      margin-bottom: 15px;
    }
    .item-title {
      font-weight: bold;
      font-size: 16px;
    }
    .item-subtitle {
      font-size: 14px;
      color: #7f8c8d;
      font-style: italic;
    }
    .item-desc {
      font-size: 14px;
      margin-top: 5px;
    }
    .skills-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .skill-badge {
      background-color: #ecf0f1;
      border: 1px solid #bdc3c7;
      padding: 3px 8px;
      border-radius: 12px;
      font-size: 12px;
    }
  </style>
</head>
<body>

  <!-- Header Section -->
  <h1>Currículo</h1>
  <div class="contact-info">
    <% if (profile.user?.email) { %>
      <div><strong>Email:</strong> <%= profile.user.email %></div>
    <% } %>
    <% if (profile.telefone) { %>
      <div><strong>Telefone:</strong> <%= profile.telefone %></div>
    <% } %>
    <% if (profile.address) { %>
      <div><strong>Endereço:</strong> <%= profile.address %></div>
    <% } %>
  </div>

  <!-- Bio Section -->
  <% if (profile.bio) { %>
    <div class="section">
      <h2>Resumo Profissional</h2>
      <div class="item-desc"><%= profile.bio %></div>
    </div>
  <% } %>

  <!-- Experience Section -->
  <% if (profile.experiences && profile.experiences.length > 0) { %>
    <div class="section">
      <h2>Experiência Profissional</h2>
      <% profile.experiences.forEach(function(exp) { %>
        <div class="item">
          <div class="item-title"><%= exp.role %> na <%= exp.company %></div>
          <div class="item-subtitle">
            <%= exp.start_date %> - <%= exp.end_date ? exp.end_date : 'Atual' %>
          </div>
          <div class="item-desc"><%= exp.description %></div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <!-- Education Section -->
  <% if (profile.educations && profile.educations.length > 0) { %>
    <div class="section">
      <h2>Formação Acadêmica</h2>
      <% profile.educations.forEach(function(edu) { %>
        <div class="item">
          <div class="item-title"><%= edu.degree %> em <%= edu.field_of_study %></div>
          <div class="item-subtitle">
            <%= edu.institution %> (<%= edu.start_date %> - <%= edu.end_date ? edu.end_date : 'Cursando' %>)
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <!-- Skills Section -->
  <% if (profile.skills && profile.skills.length > 0) { %>
    <div class="section">
      <h2>Habilidades</h2>
      <div class="skills-list">
        <% profile.skills.forEach(function(skill) { %>
          <span class="skill-badge"><%= skill %></span>
        <% }); %>
      </div>
    </div>
  <% } %>

</body>
</html>
