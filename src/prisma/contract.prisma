enum Role {
  JOB_SEEKER
  EMPLOYER
  ADMIN
}

enum JobStatus {
  PENDING
  ACTIVE
  FILLED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  role          Role     @default(EMPLOYER)
  created_at    TimestamptzString @default(now())
  
  jobs              Job[]
  applications      Application[]
  company_profile   CompanyProfile?
  candidate_profile CandidateProfile?

  candidate_rooms   ChatRoom[] @relation("CandidateRooms")
  employer_rooms    ChatRoom[] @relation("EmployerRooms")
  sent_messages     Message[]  @relation("SentMessages")
}

model CompanyProfile {
  id            String  @id @default(uuid())
  user_id       String  @unique
  nome_fantasia String
  cnpj          String? @unique
  endereco      String?
  logo_url      String?
  verification_status       VerificationStatus @default(PENDING)
  verification_document_url String?
  created_at    TimestamptzString @default(now())
  updated_at    temporal.updatedAtString()

  user          User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model CandidateProfile {
  id          String  @id @default(uuid())
  user_id     String  @unique
  bio         String?
  telefone    String?
  habilidades String? // Deprecated in favor of skills array? We will keep skills array as requested.
  skills      String[] @default([])
  address     String?
  created_at  TimestamptzString @default(now())
  updated_at  temporal.updatedAtString()

  user        User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  experiences Experience[]
  educations  Education[]
}

model Experience {
  id           String  @id @default(uuid())
  candidate_id String
  company      String
  role         String
  start_date   String
  end_date     String?
  description  String

  candidate    CandidateProfile @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
}

model Education {
  id             String  @id @default(uuid())
  candidate_id   String
  institution    String
  degree         String
  field_of_study String
  start_date     String
  end_date       String?

  candidate      CandidateProfile @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
}

model Job {
  id               String    @id @default(uuid())
  employer_id      String
  title            String
  description      String
  address          String @default("")
  work_schedule    String @default("")
  salary_range     String?
  mandatory_qualifications    String[] @default([])
  differential_qualifications String[] @default([])
  benefits         String[] @default([])
  
  contact_whatsapp String?
  contact_email    String?
  status           JobStatus @default(PENDING)
  
  created_at       TimestamptzString  @default(now())
  updated_at       temporal.updatedAtString()
  deleted_at       TimestamptzString? // Soft Delete

  employer         User      @relation(fields: [employer_id], references: [id], onDelete: Cascade)
  applications     Application[]
  chat_rooms       ChatRoom[]
}

model Application {
  id           String            @id @default(uuid())
  job_id       String
  applicant_id String
  
  cover_letter String?
  resume_url   String?
  
  status       ApplicationStatus @default(PENDING)
  
  created_at   TimestamptzString @default(now())
  updated_at   temporal.updatedAtString()

  job          Job               @relation(fields: [job_id], references: [id], onDelete: Cascade)
  applicant    User              @relation(fields: [applicant_id], references: [id], onDelete: Cascade)
  
  @@unique([job_id, applicant_id])
}

model ChatRoom {
  id           String            @id @default(uuid())
  job_id       String
  candidate_id String
  employer_id  String
  created_at   TimestamptzString @default(now())

  job          Job               @relation(fields: [job_id], references: [id], onDelete: Cascade)
  candidate    User              @relation("CandidateRooms", fields: [candidate_id], references: [id], onDelete: Cascade)
  employer     User              @relation("EmployerRooms", fields: [employer_id], references: [id], onDelete: Cascade)
  messages     Message[]
}

model Message {
  id         String            @id @default(uuid())
  room_id    String
  sender_id  String
  content    String
  is_read    Boolean           @default(false)
  created_at TimestamptzString @default(now())

  room       ChatRoom          @relation(fields: [room_id], references: [id], onDelete: Cascade)
  sender     User              @relation("SentMessages", fields: [sender_id], references: [id], onDelete: Cascade)
}
