enum Role {
  JOB_SEEKER
  EMPLOYER
  ADMIN
}

enum JobStatus {
  PENDING
  ACTIVE
  FILLED
  REJECTED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  role          Role     @default(EMPLOYER)
  created_at    TimestamptzString @default(now())
  
  jobs          Job[]
}

model Job {
  id               String    @id @default(uuid())
  employer_id      String
  company_name     String
  title            String
  description      String
  location         String
  contact_whatsapp String?
  contact_email    String?
  status           JobStatus @default(PENDING)
  
  created_at       TimestamptzString  @default(now())
  updated_at       temporal.updatedAtString()
  deleted_at       TimestamptzString? // Soft Delete

  employer         User      @relation(fields: [employer_id], references: [id], onDelete: Cascade)
}
