
enum Role {
  JOB_SEEKER
  EMPLOYER
  ADMIN
}

enum JobStatus {
  PENDING
  ACTIVE
  FILLED
  REJECTED
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  INTERVIEW
  HIRED
  REJECTED
}

enum WorkModel {
  ON_SITE
  HYBRID
  REMOTE
}

enum ContractType {
  CLT
  PJ
  INTERNSHIP
  FREELANCE
  APPRENTICE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  role          Role     @default(EMPLOYER)
  created_at    TimestamptzString @default(now())
  deleted_at    TimestamptzString?
  
  jobs              Job[]
  applications      Application[]
  company_profile   CompanyProfile?
  candidate_profile CandidateProfile?

  candidate_rooms   ChatRoom[] @relation("CandidateRooms")
  employer_rooms    ChatRoom[] @relation("EmployerRooms")
  sent_messages     Message[]  @relation("SentMessages")

  saved_by_employers SavedCandidate[] @relation("CandidateSaved")
  saved_candidates   SavedCandidate[] @relation("EmployerSaved")
}

model CompanyProfile {
  id            String  @id @default(uuid())
  user_id       String  @unique
  nome_fantasia String
  cnpj          String? @unique
  endereco      String?
  logo_url      String?
  verification_status       VerificationStatus @default(PENDING)
  verification_document_url String?
  created_at    TimestamptzString @default(now())
  updated_at    temporal.updatedAtString()

  user          User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model CandidateProfile {
  id          String  @id @default(uuid())
  user_id     String  @unique
  bio         String?
  telefone    String?
  habilidades String?
  skills      String[] @default([])
  address     String?
  created_at  TimestamptzString @default(now())
  updated_at  temporal.updatedAtString()

  user        User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  experiences Experience[]
  educations  Education[]
}

model Experience {
  id           String  @id @default(uuid())
  candidate_id String
  company      String
  role         String
  start_date   String
  end_date     String?
  description  String

  candidate    CandidateProfile @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
}

model Education {
  id             String  @id @default(uuid())
  candidate_id   String
  institution    String
  degree         String
  field_of_study String
  start_date     String
  end_date     String?

  candidate      CandidateProfile @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
}

model Job {
  id               String    @id @default(uuid())
  employer_id      String
  title            String
  description      String
  address          String @default("")
  work_schedule    String @default("")
  salary_range     String?
  mandatory_qualifications    String[] @default([])
  differential_qualifications String[] @default([])
  benefits         String[] @default([])
  
  work_model       WorkModel
  contract_type    ContractType
  is_salary_visible Boolean   @default(true)
  is_pcd           Boolean   @default(false)
  expires_at       TimestamptzString?
  
  contact_whatsapp String?
  contact_email    String?
  status           JobStatus @default(PENDING)
  
  created_at       TimestamptzString  @default(now())
  updated_at       temporal.updatedAtString()
  deleted_at       TimestamptzString? // Soft Delete

  employer         User      @relation(fields: [employer_id], references: [id], onDelete: Cascade)
  applications     Application[]
  chat_rooms       ChatRoom[]
  questions        JobQuestion[]
}

model JobQuestion {
  id               String   @id @default(uuid())
  job_id           String
  question_text    String
  expected_answer  Boolean

  job              Job      @relation(fields: [job_id], references: [id], onDelete: Cascade)
  answers          ApplicationAnswer[]
}

model Application {
  id           String            @id @default(uuid())
  job_id       String
  applicant_id String
  
  cover_letter String?
  resume_url   String?
  internal_notes String?
  
  status       ApplicationStatus @default(APPLIED)
  is_knocked_out Boolean         @default(false)
  
  created_at   TimestamptzString @default(now())
  updated_at   temporal.updatedAtString()

  job          Job               @relation(fields: [job_id], references: [id], onDelete: Cascade)
  applicant    User              @relation(fields: [applicant_id], references: [id], onDelete: Cascade)
  answers      ApplicationAnswer[]
  
  @@unique([job_id, applicant_id])
}

model ApplicationAnswer {
  id             String      @id @default(uuid())
  application_id String
  question_id    String
  answer         Boolean

  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  question       JobQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)
}

model ChatRoom {
  id           String            @id @default(uuid())
  job_id       String
  candidate_id String
  employer_id  String
  created_at   TimestamptzString @default(now())

  job          Job               @relation(fields: [job_id], references: [id], onDelete: Cascade)
  candidate    User              @relation("CandidateRooms", fields: [candidate_id], references: [id], onDelete: Cascade)
  employer     User              @relation("EmployerRooms", fields: [employer_id], references: [id], onDelete: Cascade)
  messages     Message[]
}

model Message {
  id         String            @id @default(uuid())
  room_id    String
  sender_id  String
  content    String
  is_read    Boolean           @default(false)
  created_at TimestamptzString @default(now())

  room       ChatRoom          @relation(fields: [room_id], references: [id], onDelete: Cascade)
  sender     User              @relation("SentMessages", fields: [sender_id], references: [id], onDelete: Cascade)
}

model SavedCandidate {
  id           String            @id @default(uuid())
  employer_id  String
  candidate_id String
  notes        String?
  created_at   TimestamptzString @default(now())

  employer     User              @relation("EmployerSaved", fields: [employer_id], references: [id], onDelete: Cascade)
  candidate    User              @relation("CandidateSaved", fields: [candidate_id], references: [id], onDelete: Cascade)

  @@unique([employer_id, candidate_id])
}

model AuditLog {
  id         String            @id @default(uuid())
  user_id    String?
  action     String
  entity     String
  entity_id  String?
  ip_address String
  payload    Json?
  created_at TimestamptzString @default(now())
}