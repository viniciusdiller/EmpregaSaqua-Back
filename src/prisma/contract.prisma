enum Role {
  JOB_SEEKER
  EMPLOYER
  ADMIN
}

enum JobStatus {
  PENDING
  ACTIVE
  FILLED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  role          Role     @default(EMPLOYER)
  created_at    TimestamptzString @default(now())
  
  jobs              Job[]
  applications      Application[]
  company_profile   CompanyProfile?
  candidate_profile CandidateProfile?
}

model CompanyProfile {
  id            String  @id @default(uuid())
  user_id       String  @unique
  nome_fantasia String
  cnpj          String? @unique
  endereco      String?
  logo_url      String?
  created_at    TimestamptzString @default(now())
  updated_at    temporal.updatedAtString()

  user          User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model CandidateProfile {
  id          String  @id @default(uuid())
  user_id     String  @unique
  bio         String?
  telefone    String?
  habilidades String?
  resume_text String?
  created_at  TimestamptzString @default(now())
  updated_at  temporal.updatedAtString()

  user        User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Job {
  id               String    @id @default(uuid())
  employer_id      String
  company_name     String
  title            String
  description      String
  location         String
  contact_whatsapp String?
  contact_email    String?
  status           JobStatus @default(PENDING)
  
  created_at       TimestamptzString  @default(now())
  updated_at       temporal.updatedAtString()
  deleted_at       TimestamptzString? // Soft Delete

  employer         User      @relation(fields: [employer_id], references: [id], onDelete: Cascade)
  applications     Application[]
}

model Application {
  id           String            @id @default(uuid())
  job_id       String
  applicant_id String
  
  cover_letter String?
  resume_url   String?
  
  status       ApplicationStatus @default(PENDING)
  
  created_at   TimestamptzString @default(now())
  updated_at   temporal.updatedAtString()

  job          Job               @relation(fields: [job_id], references: [id], onDelete: Cascade)
  applicant    User              @relation(fields: [applicant_id], references: [id], onDelete: Cascade)
  
  @@unique([job_id, applicant_id])
}
